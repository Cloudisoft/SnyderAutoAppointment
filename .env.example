# ---------------------------------------------------------------------------
# Snyder Auto Appointment — environment variables
# Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# --- Backend server --------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Public origin of the web app, used for links back into the app in emails (call details etc.).
APP_PUBLIC_URL=http://localhost:5173
# Single-service deploys: serve the built web app from the API (path to apps/frontend/dist). Leave unset in dev.
FRONTEND_DIST_DIR=

# --- Supabase (database, auth, storage) ------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe for the browser, protected by RLS).
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string used by the backend (transactions, migrations).
DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Vapi (call engine) ----------------------------------------------------
VAPI_API_KEY=
# Shared secret Vapi sends with every server/tool request (X-Vapi-Secret header). Min 16 chars.
VAPI_WEBHOOK_SECRET=
# Public HTTPS origin of this backend; Vapi calls ${BACKEND_PUBLIC_URL}/webhooks/vapi.
BACKEND_PUBLIC_URL=https://api.example.com

# --- Cartesia (voice, sonic-3) ---------------------------------------------
CARTESIA_API_KEY=

# --- Twilio (numbers / caller ID) ------------------------------------------
# Default account used when importing numbers; per-org credentials are stored encrypted in Supabase Vault.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- OpenAI (post-call summary / transcript extraction) --------------------
OPENAI_API_KEY=

# --- Email (SMTP via Nodemailer) -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# --- Background jobs -------------------------------------------------------
# Set to false to run an API-only instance (no dialer / jobs).
JOBS_ENABLED=true
DIALER_INTERVAL_MS=5000
CALL_RECONCILE_INTERVAL_MS=60000

# --- Auto Appointments -----------------------------------------------------
# Public origin of the prospect-facing appointment page; emails link to ${APPOINTMENTS_PUBLIC_URL}/a/{token}.
# Usually the same origin as the web app.
APPOINTMENTS_PUBLIC_URL=http://localhost:5173
# How often each "process one batch" appointment job runs (milliseconds).
# Releases pending holds past hold_expires_at whose call never confirmed them.
APPOINTMENT_HOLD_EXPIRY_INTERVAL_MS=60000
# Sends queued confirmation / reschedule / cancellation / reminder / host emails (retries with backoff).
APPOINTMENT_NOTIFICATION_DISPATCH_INTERVAL_MS=15000
# Enqueues reminders at each campaign's offsets (default 24h and 1h before).
APPOINTMENT_REMINDER_INTERVAL_MS=60000
# Marks confirmed appointments 2h past their end as no-show.
APPOINTMENT_NO_SHOW_INTERVAL_MS=300000
# Future Twilio SMS confirmations/reminders. Keep false: the SMS sender is stubbed.
# Even when true, SMS only goes out for campaigns that switch on "Also send SMS".
SMS_APPOINTMENTS_ENABLED=false

# --- Frontend (Vite; only these reach the browser) -------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
# Leave empty in production when the API serves the app (same origin).
VITE_API_BASE_URL=http://localhost:8080
