{
  "name": "@snyder/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@snyder/shared": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "libphonenumber-js": "^1.11.17",
    "luxon": "^3.5.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^9.14.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2"
  }
}
